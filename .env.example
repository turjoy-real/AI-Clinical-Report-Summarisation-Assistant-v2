# Educational prototype. Not for clinical use. Synthetic patients only.
APP_ENV=development
MOCK_LLM=true

# OpenAI is primary when MOCK_LLM=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Gemini is the automatic fallback for generation and embeddings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Outbound tools off by default for the rebuild
ENABLE_PUBMED=false
ENABLE_OPENFDA=false

DATA_DIR=../data
CHROMA_DIR=../data/chroma
CHECKPOINT_DIR=./.checkpoints
LOG_DIR=./.runs

FRONTEND_ORIGIN=http://localhost:5173
